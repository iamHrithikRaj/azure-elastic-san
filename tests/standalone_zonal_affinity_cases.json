{
  "addressCases": [
    {
      "name": "numeric-ipv4-order-and-duplicates",
      "addresses": ["10.0.0.10", "10.0.0.2", "10.0.0.1", "10.0.0.2"],
      "expected": ["10.0.0.1", "10.0.0.2", "10.0.0.10"]
    },
    {
      "name": "compressed-lowercase-ipv6",
      "addresses": ["FD00:0000:0000:0000:0000:0000:0000:0010", "fd00::2", "fd00::1", "FD00::0001"],
      "expected": ["fd00::1", "fd00::2", "fd00::10"]
    },
    {
      "name": "mixed-family-and-mapped-address",
      "addresses": ["fd00::1", "::ffff:10.0.0.10", "10.0.0.2", "10.0.0.10"],
      "expected": ["10.0.0.2", "10.0.0.10", "fd00::1"]
    },
    {
      "name": "public-and-private-unicast",
      "addresses": ["172.16.0.1", "20.1.2.3", "192.168.1.1"],
      "expected": ["20.1.2.3", "172.16.0.1", "192.168.1.1"]
    },
    {"name": "empty", "addresses": [], "error": true},
    {"name": "one", "addresses": ["10.0.0.1"], "error": true},
    {"name": "two", "addresses": ["10.0.0.1", "10.0.0.2"], "error": true},
    {"name": "four", "addresses": ["10.0.0.1", "10.0.0.2", "10.0.0.3", "10.0.0.4"], "error": true},
    {"name": "mapped-duplicate-is-not-third", "addresses": ["10.0.0.1", "::ffff:10.0.0.1", "10.0.0.2"], "error": true},
    {"name": "invalid-fourth-is-not-discarded", "addresses": ["10.0.0.1", "10.0.0.2", "10.0.0.3", "invalid"], "error": true},
    {"name": "whitespace", "addresses": [" 10.0.0.1", "10.0.0.2", "10.0.0.3"], "error": true},
    {"name": "short-ipv4", "addresses": ["10.1", "10.0.0.2", "10.0.0.3"], "error": true},
    {"name": "octal-ipv4", "addresses": ["010.0.0.1", "10.0.0.2", "10.0.0.3"], "error": true},
    {"name": "octal-mapped-tail", "addresses": ["::ffff:010.0.0.1", "10.0.0.2", "10.0.0.3"], "error": true},
    {"name": "ipv4-unspecified", "addresses": ["0.0.0.0", "10.0.0.2", "10.0.0.3"], "error": true},
    {"name": "ipv6-unspecified", "addresses": ["::", "10.0.0.2", "10.0.0.3"], "error": true},
    {"name": "mapped-loopback", "addresses": ["::ffff:127.0.0.1", "10.0.0.2", "10.0.0.3"], "error": true},
    {"name": "ipv6-loopback", "addresses": ["::1", "10.0.0.2", "10.0.0.3"], "error": true},
    {"name": "ipv4-multicast", "addresses": ["224.0.0.1", "10.0.0.2", "10.0.0.3"], "error": true},
    {"name": "ipv6-multicast", "addresses": ["ff02::1", "10.0.0.2", "10.0.0.3"], "error": true},
    {"name": "ipv4-link-local", "addresses": ["169.254.1.1", "10.0.0.2", "10.0.0.3"], "error": true},
    {"name": "ipv6-link-local", "addresses": ["fe80::1", "10.0.0.2", "10.0.0.3"], "error": true},
    {"name": "scoped-ipv6", "addresses": ["fd00::1%3", "10.0.0.2", "10.0.0.3"], "error": true},
    {"name": "broadcast", "addresses": ["255.255.255.255", "10.0.0.2", "10.0.0.3"], "error": true}
  ],
  "mappingCases": [
    {
      "name": "trimmed-logical-zone-and-region",
      "locations": [{"name": " EASTUS ", "availabilityZoneMappings": [{"logicalZone": " 2 ", "physicalZone": " EASTUS-AZ3 "}]}],
      "location": "eastus",
      "logicalZone": "2",
      "expected": "EASTUS-AZ3"
    },
    {
      "name": "duplicate-trimmed-zone",
      "locations": [{"name": "eastus", "availabilityZoneMappings": [{"logicalZone": "2", "physicalZone": "eastus-az1"}, {"logicalZone": " 2 ", "physicalZone": "eastus-az3"}]}],
      "location": "eastus",
      "logicalZone": "2",
      "error": true
    },
    {
      "name": "missing-zone",
      "locations": [{"name": "eastus", "availabilityZoneMappings": [{"logicalZone": "1", "physicalZone": "eastus-az1"}]}],
      "location": "eastus",
      "logicalZone": "2",
      "error": true
    },
    {
      "name": "malformed-mappings",
      "locations": [{"name": "eastus", "availabilityZoneMappings": {}}],
      "location": "eastus",
      "logicalZone": "2",
      "error": true
    }
  ],
  "sessionCount": 32,
  "expectedCounts": [11, 11, 10]
}
